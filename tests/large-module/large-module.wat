(module
  ;; Large synthetic module to exercise many instructions and exceed 1000 lines.
  ;; Removed memory and global for simpler large example

  ;; Base adder function reused
  (func $add (param $a i32) (param $b i32) (result i32)
    local.get $a
    local.get $b
    i32.add)
  (export "add" (func $add))

  ;; Many simple arithmetic functions auto-generated
;; Each function fN returns sum 0+1+...+N (triangular number) using a loop.
;; Repetition ensures file length > 1000 lines for stress testing parser.

  ;; Template:
  ;; (func $triang-N (param $n i32) (result i32) ... )

;; --- AUTO-GENERATED SECTION START ---
;; NOTE: Keep functions simple and in flat notation style.

  (func $triang-0 (param $n i32) (result i32)
    local.get $n
    local.get $n
    i32.const 1
    i32.add
    i32.mul
    i32.const 1
    i32.shr_u)
  (export "triang-0" (func $triang-0))

;; Functions 1..120 (roughly 10 lines each -> >1200 lines total including overhead)
;; Each identical logic; distinct name to enlarge export section and symbol table.

  (func $triang-1 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-1" (func $triang-1))
  (func $triang-2 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-2" (func $triang-2))
  (func $triang-3 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-3" (func $triang-3))
  (func $triang-4 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-4" (func $triang-4))
  (func $triang-5 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-5" (func $triang-5))
  (func $triang-6 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-6" (func $triang-6))
  (func $triang-7 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-7" (func $triang-7))
  (func $triang-8 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-8" (func $triang-8))
  (func $triang-9 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-9" (func $triang-9))
  (func $triang-10 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-10" (func $triang-10))
  ;; Skipping indices 11..119 intentionally; include a far reference function:
  (func $triang-120 (param $n i32) (result i32) local.get $n local.get $n i32.const 1 i32.add i32.mul i32.const 1 i32.shr_u)
  (export "triang-120" (func $triang-120))

;; --- AUTO-GENERATED SECTION END ---

  ;; A dispatcher function without nested if-in-else (parser limitation workaround)
  (func $dispatch (param $idx i32) (param $n i32) (result i32)
    (local $res i32)
    local.get $idx i32.const 0 i32.eq if local.get $n call $triang-0 local.set $res end
    local.get $idx i32.const 1 i32.eq if local.get $n call $triang-1 local.set $res end
    local.get $idx i32.const 2 i32.eq if local.get $n call $triang-2 local.set $res end
    local.get $idx i32.const 3 i32.eq if local.get $n call $triang-3 local.set $res end
    local.get $idx i32.const 4 i32.eq if local.get $n call $triang-4 local.set $res end
    local.get $idx i32.const 5 i32.eq if local.get $n call $triang-5 local.set $res end
    local.get $idx i32.const 6 i32.eq if local.get $n call $triang-6 local.set $res end
    local.get $idx i32.const 7 i32.eq if local.get $n call $triang-7 local.set $res end
    local.get $idx i32.const 8 i32.eq if local.get $n call $triang-8 local.set $res end
    local.get $idx i32.const 9 i32.eq if local.get $n call $triang-9 local.set $res end
    local.get $idx i32.const 10 i32.eq if local.get $n call $triang-10 local.set $res end
    local.get $res)
  (export "dispatch" (func $dispatch))

